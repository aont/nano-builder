+						(defined _MSC_VER || defined __MINGW32__))
@@ -192,0 +194,49 @@
+#if defined _WIN32 && (defined _MSC_VER || defined __MINGW32__)
+/* Read a Unicode character on native Windows, and feed its UTF-8 bytes to
+ * nano's byte-oriented input machinery.  Special ncurses keycodes pass
+ * through unchanged. */
+static int wgetch_as_utf8(WINDOW *frame)
+{
+	static unsigned char pending_bytes[4];
+	static int pending_count = 0;
+	static int pending_index = 0;
+	wint_t wide_input;
+	int status;
+
+	if (pending_index < pending_count)
+		return pending_bytes[pending_index++];
+
+	status = wget_wch(frame, &wide_input);
+	if (status == ERR)
+		return ERR;
+	if (status == KEY_CODE_YES)
+		return (int)wide_input;
+
+	if (wide_input <= 0x7F) {
+		pending_bytes[0] = wide_input;
+		pending_count = 1;
+	} else if (wide_input <= 0x7FF) {
+		pending_bytes[0] = 0xC0 | (wide_input >> 6);
+		pending_bytes[1] = 0x80 | (wide_input & 0x3F);
+		pending_count = 2;
+	} else if (wide_input <= 0xFFFF) {
+		pending_bytes[0] = 0xE0 | (wide_input >> 12);
+		pending_bytes[1] = 0x80 | ((wide_input >> 6) & 0x3F);
+		pending_bytes[2] = 0x80 | (wide_input & 0x3F);
+		pending_count = 3;
+	} else {
+		pending_bytes[0] = 0xF0 | (wide_input >> 18);
+		pending_bytes[1] = 0x80 | ((wide_input >> 12) & 0x3F);
+		pending_bytes[2] = 0x80 | ((wide_input >> 6) & 0x3F);
+		pending_bytes[3] = 0x80 | (wide_input & 0x3F);
+		pending_count = 4;
+	}
+
+	pending_index = 1;
+	return pending_bytes[0];
+}
+#define WGETCH(frame)  wgetch_as_utf8(frame)
+#else
+#define WGETCH(frame)  wgetch(frame)
+#endif
+
